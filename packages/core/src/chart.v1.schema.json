{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lineup.local/schema/chart.v1.json",
  "title": "Lineup chart, version 1",
  "description": "Instrument-agnostic chart. t/duration are seconds on the song clock (0 = first beat after the count-in). Pitch is concert MIDI. The loader additionally sorts notes by time and warns on unknown fields and duplicates; those checks are not expressible here.",
  "type": "object",
  "required": ["version", "meta", "notes"],
  "properties": {
    "version": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["title", "bpm"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
        "artist": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
        "bpm": { "type": "number", "minimum": 20, "maximum": 400 },
        "countInBeats": { "type": "integer", "minimum": 0, "maximum": 16, "default": 4 },
        "audio": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "instruments": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["t"],
        "properties": {
          "t": { "type": "number", "minimum": 0 },
          "duration": { "type": "number", "minimum": 0, "default": 0 },
          "lane": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "\\S" },
          "pitch": { "type": "number", "minimum": 0, "maximum": 127 },
          "expected": {
            "type": "object",
            "properties": {
              "chord": { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "\\S" },
              "direction": { "enum": ["up", "down"] }
            }
          }
        }
      }
    }
  }
}
